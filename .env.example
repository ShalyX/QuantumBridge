# Local defaults use SQLite when DATABASE_URL is unset.
# Set DATABASE_URL to enable Postgres.

# DATABASE_URL=postgres://user:password@localhost:5432/quantumbridge
# PGSSLMODE=disable

IRIS_API=https://iris-api-sandbox.circle.com
QUANTUM_API_PORT=8787
QUANTUM_WORKER_DISABLED=0
CORS_ORIGIN=http://localhost:3005,http://localhost:5173

# Keep disabled by default. You can also test with ?solanaForwarder=1 in the app URL.
VITE_EXPERIMENTAL_SOLANA_FORWARDER=0

{
  "name": "quantum-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --no-warnings=ExperimentalWarning server/index.js",
    "api:watch": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "worker": "node --no-warnings=ExperimentalWarning server/worker.js",
    "dev:clean": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force node_modules\\.vite -ErrorAction SilentlyContinue\"; vite",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:release": "npm test && npm run build && npm run test:e2e",
    "build": "vite build",
    "preview": "vite preview",
    "verify:prod": "npm test && npm run build",
    "verify:clean": "npm ci && npm run verify:prod",
    "migrate:postgres": "node scripts/migrate-postgres-history.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@circle-fin/adapter-solana-kit": "1.4.5",
    "@circle-fin/adapter-viem-v2": "1.8.3",
    "@circle-fin/app-kit": "1.4.1",
    "@circle-fin/bridge-kit": "1.9.0",
    "@solana/kit": "5.5.1",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3",
    "pg": "8.16.3",
    "viem": "2.48.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "node-stdlib-browser": "1.3.1",
    "patch-package": "8.0.1",
    "vite": "5.4.21",
    "vite-plugin-node-polyfills": "0.22.0"
  }
}
